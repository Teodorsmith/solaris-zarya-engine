# ──────────────────────────────────────────────────────────────
# Solaris Zarya Engine — Environment Configuration
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your keys.
# Only the key for your chosen AI_BRAIN is required.
# ──────────────────────────────────────────────────────────────

# ── Active Brain ─────────────────────────────────────────────
# Options: gemini | groq | openai | openrouter | local | mock | moa_router
#          opencodezen | anthropic
AI_BRAIN="groq"

# ── Brain API Keys (set the one matching AI_BRAIN) ──────────
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENROUTER_API_KEY=""
OPENCODEZEN_API_KEY=""

# ── Model Overrides ──────────────────────────────────────────
# Each provider uses its default model unless overridden here.
GEMINI_MODEL="gemini-3.6-flash"
GROQ_MODEL="qwen/qwen3.6-27b"
OPENROUTER_MODEL="mistralai/ministral-8b-2512"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# ── Rate Limits (requests per minute) ────────────────────────
GEMINI_RPM_LIMIT="15"
GROQ_RPM_LIMIT="30"

# ── Local LLM (Ollama / LM Studio / vLLM) ───────────────────
# Set AI_BRAIN="local" and point to your local endpoint.
# LOCAL_LLM_API_KEY="your-key-here"
# LOCAL_LLM_BASE_URL="http://localhost:11434/v1"

# ── Workspace ────────────────────────────────────────────────
# Root directory for project indexing. Default: current directory.
WORKSPACE_DIR="."

# ── Game Engine Integration (Phase 5) ────────────────────────
# Uncomment and set paths to enable Unity / Blender integration.
# UNITY_EXE="C:/Program Files/Unity/Hub/Editor/2022.3.0f1/Editor/Unity.exe"
# UNITY_PROJECT_PATH="E:/MyUnityProject"
# BLENDER_EXE="C:/Program Files/Blender Foundation/Blender 4.0/blender.exe"
